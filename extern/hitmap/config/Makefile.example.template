#
# 1. DEFINITIONS, FLAGS, AND EXTERNAL LIBRARIES FOR THIS PARTICULAR APPLICATION
# 	(THEY WILL BE AUTOMATICALLY ADDED TO THE MAIN COMPILATION COMMAND)
#
APP_FLAGS=
APP_LIBS=
APP_TESTING=

#
# 2. DECLARE APPLICATION TARGETS,
# 	 AND OTHER FILES TO BE AUTOMATICALLY REMOVED WHEN CLEANING
#
APP_TARGETS=<target_names>
APP_CLEAN=

#
# 4. LOAD Hitmap COMPILING DEFINITIONS
#	( PLEASE, SET HITMAP BASEDIR )
#
HIT_BASEDIR=../..
include $(HIT_BASEDIR)/config/make.def

#
# 5. DECLARE TARGET SOURCES, AND SPECIFIC BUILDING RULES FOR YOUR APPLICATION IF NEEDED
# 	( SUBSTITUTE THE EXAMPLES BELLOW )
#

# 5.1. EXAMPLE 1: IMPLICIT COMPILATION LINE
# 		IF THE ONLY DEPENDENCE IS A .c FILE WITH THE SAME NAME, THIS LINE CAN BE SKIPPED
target1: target1.c

# 5.2. EXAMPLE 2: IMPLICIT COMPILATION LINE WITH SEVERAL .c AND .h DEPENDENCES
# 		THIS LINES WILL LAUNCH THE COMPILER FOR ONLY THE .c FILES IN THE DEPENDENCES LIST
target2: source1.c source1.h source2.c another.h

# 5.3. EXAMPLE 3: EXPLICIT COMPILATION LINE
# 		USE IT TO CHANGE/ADD SPECIFIC FLAGS, OR COMPILE OTHER SOURCE FILES
target3: other1.c other2.c
	$(HIT_COMPILE) $< $(HIT_LIBS) ... <other_flags>  -o $@

# 5.4. OTHER COMPILATION RULES
<dependence1>:
	<actions_1>

<dependence2>: <other_dependences>
	<actions_2>

...

#
# END
#
